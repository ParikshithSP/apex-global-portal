# ---- REQUIRED in production ----
# Long random string used to sign sessions & OTPs. Generate with: openssl rand -hex 32
SESSION_SECRET=

# ---- Email for OTPs (choose ONE). If none is set, the app runs in DEMO MODE and shows the OTP on screen. ----
# Option A: SMTP (Office 365: smtp.office365.com:587 | Gmail: smtp.gmail.com:465 with an App Password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Option B: Resend (https://resend.com) – needs a verified sending domain
RESEND_API_KEY=
# Sender shown in the email
MAIL_FROM=Apex Global Search <no-reply@yourdomain.com>

# ---- Access control (recommended) ----
# Only these email domains can sign up (comma separated). Empty = any domain.
ADMIN_ALLOWED_DOMAINS=
HOD_ALLOWED_DOMAINS=
# If set, HOD sign-up also asks for this shared internal code.
HOD_SIGNUP_CODE=
# 1 (default) = new HR Admins must be approved by a HOD. 0 = auto-approve (not recommended).
REQUIRE_HOD_APPROVAL=1

# ---- Optional ----
SESSION_HOURS=8
# 0 = do not create the sample job openings on first launch
SEED_DEMO_DATA=1
# 1 = force demo mode (show OTP on screen) even if email is configured
DEMO_MODE=
